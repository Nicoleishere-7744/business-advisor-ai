# ---------- پایگاه داده ----------
# توسعه (SQLite):
DATABASE_URL="file:./dev.db"
# پروداکشن (PostgreSQL):
# DATABASE_URL="postgresql://user:pass@localhost:5432/business_advisor?schema=public"

# ---------- عمومی ----------
# آدرس پایه اپ؛ برای ساخت callbackUrl درگاه پرداخت استفاده می‌شود
APP_URL="http://localhost:3000"

# ---------- امنیت ----------
# کلید امضای JWT (حداقل ۳۲ کاراکتر) — با node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# کلید رمزنگاری تنظیمات حساس: دقیقاً ۶۴ کاراکتر hex (۳۲ بایت)
APP_ENCRYPTION_KEY=""

# ---------- هوش مصنوعی (OpenRouter) ----------
# در صورت نیاز به رله/پروکسی خارجی فقط همین مقدار را عوض کنید
AI_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""

# ---------- پیامک (IPPanel Edge) ----------
IPPANEL_TOKEN=""
# شماره فرستنده در فرمت E.164
IPPANEL_FROM="+983000505"
# کد پترن مربوط به کد ورود
IPPANEL_OTP_PATTERN=""
# در حالت توسعه کد به‌جای ارسال، در کنسول سرور چاپ می‌شود
SMS_DEV_MODE="true"

# ---------- درگاه پرداخت (زیبال) ----------
# مقدار "zibal" یعنی حالت سندباکس
ZIBAL_MERCHANT="zibal"

# ---------- ادمین ----------
# شماره‌های موبایلی که هنگام seed یا اولین ورود نقش admin می‌گیرند (با کاما جدا شود)
ADMIN_PHONES="09121234567"
